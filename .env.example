# Neon Postgres — récupère depuis console.neon.tech (use pooled connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Upstash Redis — rate limit (optionnel). Get at console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Push notifications (VAPID). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:you@example.com"
